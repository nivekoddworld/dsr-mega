<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DS1Mod.DemoMod</AssemblyName>
    <RootNamespace>DS1Mod.DemoMod</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK gives us ModBase + pulls in Core transitively; Core gives us
         GameMemory (for the AOB scanner) and DS1ImGui (for the overlay). -->
    <ProjectReference Include="..\..\framework\DS1Mod.SDK\DS1Mod.SDK.csproj" />
    <ProjectReference Include="..\..\framework\DS1Mod.Core\DS1Mod.Core.csproj" />
  </ItemGroup>
</Project>
