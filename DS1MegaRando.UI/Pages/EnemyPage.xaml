<UserControl x:Class="DS1MegaRando.UI.Pages.EnemyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource DS1Bg}">
    <StackPanel Margin="0,0,0,24">

        <TextBlock Text="ENEMY RANDOMIZER"
                   Style="{StaticResource DS1Heading}" FontSize="20" Margin="0,0,0,20"/>

        <!-- Master toggle -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <CheckBox Style="{StaticResource DS1CheckBox}"
                      Content="Enable Enemy Randomizer"
                      IsChecked="{Binding Enemies.EnableEnemyRandomizer}"
                      FontSize="15"/>
        </Border>

        <!-- Placement Mode -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="PLACEMENT MODE" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,12"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="EnemyMode"
                             Content="Full Random  —  Any enemy can appear anywhere"
                             IsChecked="{Binding Enemies.EnemyPlacementMode, Converter={StaticResource EnumEquals}, ConverterParameter=FullRandom}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="EnemyMode"
                             Content="Category Restricted  —  Enemies swap within similar type groups"
                             IsChecked="{Binding Enemies.EnemyPlacementMode, Converter={StaticResource EnumEquals}, ConverterParameter=CategoryRestricted}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="EnemyMode"
                             Content="Area Cohesive  —  Enemies prefer to stay in similar areas"
                             IsChecked="{Binding Enemies.EnemyPlacementMode, Converter={StaticResource EnumEquals}, ConverterParameter=AreaCohesive}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="EnemyMode"
                             Content="Boss Only  —  Only boss encounters are shuffled"
                             IsChecked="{Binding Enemies.EnemyPlacementMode, Converter={StaticResource EnumEquals}, ConverterParameter=BossOnly}"/>
            </StackPanel>
        </Border>

        <!-- Bosses -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="BOSSES &amp; MINIBOSSES" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,12"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Randomize Boss Encounters"
                          IsChecked="{Binding Enemies.RandomizeBosses}"/>
                <TextBlock Style="{StaticResource DS1Label}" Margin="16,4,0,0"
                           Text="Boss-for-Boss  —  Each boss slot receives a different randomised boss"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="16,4,0,0"
                          Content="Allow Duplicate Bosses (same boss can appear multiple times)"
                          IsChecked="{Binding Enemies.AllowDuplicateBosses}"/>
                <Separator Style="{StaticResource DS1Separator}"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Randomize Minibosses (Black Knights, Silver Knights, etc.)"
                          IsChecked="{Binding Enemies.RandomizeMinibosses}"/>
            </StackPanel>
        </Border>

        <!-- Scaling -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="STAT SCALING" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,12"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,0,0,8"
                          Content="Scale enemy HP and damage to match area depth"
                          IsChecked="{Binding Enemies.ScaleEnemyStats}"/>

                <TextBlock Text="Scaling Source:" Style="{StaticResource DS1Label}" Margin="0,0,0,4"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="ScalingSrc"
                             Content="Fog Gate Depth  —  Based on the randomized world graph"
                             IsChecked="{Binding Enemies.EnemyScalingSource, Converter={StaticResource EnumEquals}, ConverterParameter=FogGateDepth}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="ScalingSrc"
                             Content="Vanilla Depth  —  Based on the original game's progression order"
                             IsChecked="{Binding Enemies.EnemyScalingSource, Converter={StaticResource EnumEquals}, ConverterParameter=VanillaDepth}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="ScalingSrc"
                             Content="Fixed  —  Use the manual multipliers below for all enemies"
                             IsChecked="{Binding Enemies.EnemyScalingSource, Converter={StaticResource EnumEquals}, ConverterParameter=Fixed}"/>

                <Separator Style="{StaticResource DS1Separator}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="HP Factor:" Style="{StaticResource DS1Label}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource DS1Slider}"
                            Minimum="0.1" Maximum="5.0" TickFrequency="0.1"
                            Value="{Binding Enemies.ScaleHPFactor}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{Binding Enemies.ScaleHPFactor, StringFormat={}{0:F1}x}"
                               Style="{StaticResource DS1Label}" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Damage Factor:" Style="{StaticResource DS1Label}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource DS1Slider}"
                            Minimum="0.1" Maximum="5.0" TickFrequency="0.1"
                            Value="{Binding Enemies.ScaleDamageFactor}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="{Binding Enemies.ScaleDamageFactor, StringFormat={}{0:F1}x}"
                               Style="{StaticResource DS1Label}" HorizontalAlignment="Right"/>
                </Grid>

                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,12,0,0"
                          Content="Also scale Poise and Armor absorption"
                          IsChecked="{Binding Enemies.ScalePoiseArmor}"/>
            </StackPanel>
        </Border>

        <!-- AI & Behavior -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="AI &amp; BEHAVIOR" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,12"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Preserve AI Behavior  —  Each enemy keeps its original AI pattern"
                          IsChecked="{Binding Enemies.PreserveAIBehavior}"
                          ToolTip="When enabled, a replaced enemy uses its own NpcThinkParam. When disabled, it inherits the target slot's AI."/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Randomize Enemy AI  —  Shuffle NpcThinkParam rows between enemies"
                          IsChecked="{Binding Enemies.RandomizeEnemyAI}"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Randomize Patrol Paths  —  Shuffle walk route points between enemies"
                          IsChecked="{Binding Enemies.RandomizePatrolPaths}"/>
            </StackPanel>
        </Border>

        <!-- NPC & Density -->
        <Border Style="{StaticResource DS1PanelBorder}">
            <StackPanel>
                <TextBlock Text="NPC &amp; DENSITY" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,12"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Protect Important NPCs  —  Andre, Frampt, Kaathe never replaced"
                          IsChecked="{Binding Enemies.ProtectImportantNPCs}"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Allow Flying Enemies in Doorways"
                          IsChecked="{Binding Enemies.AllowFlyingEnemiesInDoors}"
                          ToolTip="Flying enemies (gargoyles, crows) in doorways can clip through geometry. Disable for stability."/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Include DLC Enemies in Pool"
                          IsChecked="{Binding Enemies.IncludeDLCEnemies}"/>

                <Separator Style="{StaticResource DS1Separator}"/>
                <TextBlock Text="Enemy Density:" Style="{StaticResource DS1Label}" Margin="0,0,0,4"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="EnemyDensity"
                             Content="Vanilla  —  Original enemy count per area"
                             IsChecked="{Binding Enemies.EnemyDensityMode, Converter={StaticResource EnumEquals}, ConverterParameter=Vanilla}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="EnemyDensity"
                             Content="Reduced  —  Fewer enemies per area"
                             IsChecked="{Binding Enemies.EnemyDensityMode, Converter={StaticResource EnumEquals}, ConverterParameter=Reduced}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4" GroupName="EnemyDensity"
                             Content="Increased  —  More enemies per area"
                             IsChecked="{Binding Enemies.EnemyDensityMode, Converter={StaticResource EnumEquals}, ConverterParameter=Increased}"/>

                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,12,0,0"
                          Content="Include enemy placements in spoiler log"
                          IsChecked="{Binding Enemies.SpoilerLogEnemyPlacements}"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
