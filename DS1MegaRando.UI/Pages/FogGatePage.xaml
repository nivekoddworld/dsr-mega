<UserControl x:Class="DS1MegaRando.UI.Pages.FogGatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:DS1MegaRando.Core.Settings;assembly=DS1MegaRando.Core"
             Background="{StaticResource DS1Bg}">
    <StackPanel Margin="0,0,0,24">

        <TextBlock Text="FOG GATE RANDOMIZER"
                   Style="{StaticResource DS1Heading}" FontSize="20" Margin="0,0,0,20"/>

        <!-- Master toggle -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <CheckBox Style="{StaticResource DS1CheckBox}"
                      Content="Enable Fog Gate Randomizer"
                      IsChecked="{Binding FogGate.EnableFogGateRandomizer}"
                      FontSize="15"/>
        </Border>

        <!-- What to randomize -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="WHAT TO RANDOMIZE" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,12"/>
                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                              Content="Boss Entrances"
                              IsChecked="{Binding FogGate.RandomizeBossEntrances}"
                              ToolTip="Randomizes fog gates that lead into boss arenas."/>
                    <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                              Content="World Entrances"
                              IsChecked="{Binding FogGate.RandomizeWorldEntrances}"
                              ToolTip="Randomizes area-to-area transitions (major fog gates)."/>
                    <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                              Content="Major PvP Entrances"
                              IsChecked="{Binding FogGate.RandomizeMajorEntrances}"
                              ToolTip="Randomizes major PvP/covenant area fog gates."/>
                    <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                              Content="Minor PvP Entrances"
                              IsChecked="{Binding FogGate.RandomizeMinorEntrances}"
                              ToolTip="Randomizes minor shortcut and PvP fog gates."/>
                    <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                              Content="Bonfire Warps"
                              IsChecked="{Binding FogGate.RandomizeWarps}"
                              ToolTip="Randomizes bonfire warp targets. Very chaotic!"/>
                    <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                              Content="Include DLC"
                              IsChecked="{Binding FogGate.IncludeDLC}"
                              ToolTip="Includes Artorias of the Abyss DLC fog gates."/>
                    <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                              Content="Lordvessel Doors"
                              IsChecked="{Binding FogGate.LordvesselDoorsRandomized}"
                              ToolTip="Randomizes Lordvessel-gated passages."/>
                    <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                              Content="Randomize Starting Area"
                              IsChecked="{Binding FogGate.RandomizeStartingArea}"
                              ToolTip="Start the game in a random area instead of Undead Asylum."/>
                </UniformGrid>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,8,0,0"
                          Content="Fix Kiln Entrance (always accessible after 4 Lord Souls)"
                          IsChecked="{Binding FogGate.FixKilnEntrance}"
                          ToolTip="Ensures the Kiln of the First Flame entrance is always reachable after collecting all Lord Souls."/>
            </StackPanel>
        </Border>

        <!-- Logic mode -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="LOGIC MODE" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,12"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4"
                             Content="Normal  —  No glitches or hard skips required"
                             GroupName="LogicMode"
                             IsChecked="{Binding FogGate.LogicMode, Converter={StaticResource EnumEquals}, ConverterParameter=Normal}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4"
                             Content="Glitched  —  May require sequence breaks (tree skip, instawarp)"
                             GroupName="LogicMode"
                             IsChecked="{Binding FogGate.LogicMode, Converter={StaticResource EnumEquals}, ConverterParameter=Glitched}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4"
                             Content="No Logic  —  Completely unrestricted placement (may softlock!)"
                             GroupName="LogicMode"
                             IsChecked="{Binding FogGate.LogicMode, Converter={StaticResource EnumEquals}, ConverterParameter=NoLogic}"/>
                <Separator Style="{StaticResource DS1Separator}"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Allow Hard Skips (requires Glitched or No Logic)"
                          IsChecked="{Binding FogGate.AllowHardSkips}"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Allow Instawarps (requires Glitched or No Logic)"
                          IsChecked="{Binding FogGate.AllowInstawarps}"/>
            </StackPanel>
        </Border>

        <!-- Enemy scaling -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ENEMY SCALING FROM FOG DEPTH" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,12"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4"
                             Content="None  —  No scaling"
                             GroupName="ScalingMode"
                             IsChecked="{Binding FogGate.EnemyScalingMode, Converter={StaticResource EnumEquals}, ConverterParameter=None}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4"
                             Content="By Distance  —  Scale based on BFS distance from starting area"
                             GroupName="ScalingMode"
                             IsChecked="{Binding FogGate.EnemyScalingMode, Converter={StaticResource EnumEquals}, ConverterParameter=ByDistance}"/>
                <RadioButton Style="{StaticResource DS1RadioButton}" Margin="0,4"
                             Content="Proportional  —  Smooth curve proportional to max world depth"
                             GroupName="ScalingMode"
                             IsChecked="{Binding FogGate.EnemyScalingMode, Converter={StaticResource EnumEquals}, ConverterParameter=Proportional}"/>

                <Separator Style="{StaticResource DS1Separator}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Health Multiplier:" Style="{StaticResource DS1Label}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource DS1Slider}"
                            Minimum="0.5" Maximum="5.0" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            Value="{Binding FogGate.HealthScalingMax}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{Binding FogGate.HealthScalingMax, StringFormat={}{0:F1}x}"
                               Style="{StaticResource DS1Label}" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Damage Multiplier:" Style="{StaticResource DS1Label}" VerticalAlignment="Center"/>
                    <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource DS1Slider}"
                            Minimum="0.5" Maximum="5.0" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            Value="{Binding FogGate.DamageScalingMax}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="{Binding FogGate.DamageScalingMax, StringFormat={}{0:F1}x}"
                               Style="{StaticResource DS1Label}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Guarantees -->
        <Border Style="{StaticResource DS1PanelBorder}">
            <StackPanel>
                <TextBlock Text="GUARANTEES" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,12"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Guarantee Blacksmith Access (Andre is reachable without excessive travel)"
                          IsChecked="{Binding FogGate.GuaranteeBlacksmithAccess}"/>
                <CheckBox Style="{StaticResource DS1CheckBox}" Margin="0,4"
                          Content="Include fog connections in spoiler log"
                          IsChecked="{Binding FogGate.SpoilerLogFogConnections}"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
