<UserControl x:Class="DS1MegaRando.UI.Pages.RuntimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource DS1Bg}">
    <StackPanel Margin="0,0,0,24">

        <TextBlock Text="RUNTIME"
                   Style="{StaticResource DS1Heading}"
                   FontSize="20"
                   Margin="0,0,0,20"/>

        <!-- ── Connection ──────────────────────────────────────────── -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status dot -->
                <Ellipse x:Name="StatusDot"
                         Grid.Column="0"
                         Width="10" Height="10"
                         Fill="#C85050"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"/>

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="OFFLINE — Dark Souls Remastered not found"
                           Style="{StaticResource DS1Label}"
                           VerticalAlignment="Center"/>

                <Button x:Name="AttachBtn"
                        Grid.Column="2"
                        Style="{StaticResource DS1Button}"
                        Content="ATTACH"
                        Padding="14,6"
                        Click="AttachDetach_Click"/>
            </Grid>
        </Border>

        <!-- ── Player ──────────────────────────────────────────────── -->
        <Border x:Name="PlayerPanel"
                Style="{StaticResource DS1PanelBorder}"
                Margin="0,0,0,16"
                Opacity="0.35">
            <StackPanel>
                <TextBlock Text="PLAYER" Style="{StaticResource DS1SectionTitle}" Margin="0,0,0,14"/>

                <!-- HP -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="HP"
                               Style="{StaticResource DS1Label}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <ProgressBar x:Name="HpBar"
                                 Grid.Column="1"
                                 Style="{StaticResource DS1ProgressBar}"
                                 Height="6"
                                 Minimum="0" Maximum="1000" Value="0"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="HpText"
                               Grid.Column="2"
                               Text="— / —"
                               Style="{StaticResource DS1Label}"
                               FontFamily="{StaticResource DS1Mono}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Stamina -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="STAMINA"
                               Style="{StaticResource DS1Label}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <ProgressBar x:Name="StaminaBar"
                                 Grid.Column="1"
                                 Style="{StaticResource DS1ProgressBar}"
                                 Height="6"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="#60A060"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="StaminaText"
                               Grid.Column="2"
                               Text="—"
                               Style="{StaticResource DS1Label}"
                               FontFamily="{StaticResource DS1Mono}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Separator Style="{StaticResource DS1Separator}"/>

                <TextBlock x:Name="AreaText"
                           Text="Area: —"
                           Style="{StaticResource DS1Label}"
                           FontSize="12"
                           Margin="0,8,0,4"/>
                <TextBlock x:Name="PosText"
                           Text="Position: —"
                           Style="{StaticResource DS1Label}"
                           FontFamily="{StaticResource DS1Mono}"
                           FontSize="11"
                           Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- ── Boss Tracker ────────────────────────────────────────── -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="BossTitle"
                           Text="BOSS TRACKER — 0 / 24 killed"
                           Style="{StaticResource DS1SectionTitle}"
                           Margin="0,0,0,14"/>

                <ItemsControl x:Name="BossList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,8,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>

                                <!-- Kill indicator -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Indicator}"
                                           Foreground="{Binding IndicatorBrush}"
                                           FontFamily="{StaticResource DS1Font}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>

                                <!-- Boss name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Style="{StaticResource DS1Label}"
                                           FontSize="11"
                                           Opacity="{Binding NameOpacity}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Kill time -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding KilledAtText}"
                                           Style="{StaticResource DS1Label}"
                                           FontFamily="{StaticResource DS1Mono}"
                                           FontSize="10"
                                           Opacity="0.5"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── Fog Gate Tracker ────────────────────────────────────── -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="GateTitle"
                           Text="FOG GATES — none opened"
                           Style="{StaticResource DS1SectionTitle}"
                           Margin="0,0,0,14"/>

                <TextBlock x:Name="GateEmptyHint"
                           Text="No fog gates opened this session."
                           Style="{StaticResource DS1Label}"
                           FontSize="12"
                           Opacity="0.4"/>

                <ItemsControl x:Name="GateList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="✓"
                                           Foreground="{StaticResource DS1Gold}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Style="{StaticResource DS1Label}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding MapId}"
                                           Style="{StaticResource DS1Label}"
                                           FontFamily="{StaticResource DS1Mono}"
                                           FontSize="10"
                                           Opacity="0.45"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── Progress Log ────────────────────────────────────────── -->
        <Border Style="{StaticResource DS1PanelBorder}">
            <StackPanel>
                <TextBlock Text="PROGRESS LOG"
                           Style="{StaticResource DS1SectionTitle}"
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="LogPathText"
                           Text="—"
                           Style="{StaticResource DS1Label}"
                           FontFamily="{StaticResource DS1Mono}"
                           FontSize="11"
                           Opacity="0.65"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <Button Style="{StaticResource DS1Button}"
                        Content="OPEN FOLDER"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Click="OpenLogFolder_Click"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
