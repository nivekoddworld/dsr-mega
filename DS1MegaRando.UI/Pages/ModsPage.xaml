<UserControl x:Class="DS1MegaRando.UI.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource DS1Bg}">
    <StackPanel Margin="0,0,0,24">

        <TextBlock Text="MODS"
                   Style="{StaticResource DS1Heading}"
                   FontSize="20"
                   Margin="0,0,0,4"/>

        <TextBlock x:Name="ModsDirText"
                   Text="—"
                   Style="{StaticResource DS1Label}"
                   FontFamily="{StaticResource DS1Mono}"
                   FontSize="11"
                   Opacity="0.5"
                   Margin="0,0,0,20"
                   TextWrapping="Wrap"/>

        <!-- ── Installed mods list ──────────────────────────────────── -->
        <Border Style="{StaticResource DS1PanelBorder}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="INSTALLED MODS"
                               Style="{StaticResource DS1SectionTitle}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DS1Button}"
                            Content="INSTALL MOD…"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="InstallMod_Click"
                            ToolTip="Copy a mod DLL into the mods folder"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource DS1Button}"
                            Content="↺"
                            Padding="10,6"
                            Click="Refresh_Click"
                            ToolTip="Refresh mod list"/>
                </Grid>

                <TextBlock x:Name="EmptyHint"
                           Text="No mods installed.  Drop a mod .dll into the mods/ folder, or click Install Mod."
                           Style="{StaticResource DS1Label}"
                           FontSize="12"
                           Opacity="0.4"
                           TextWrapping="Wrap"/>

                <ListView x:Name="ModList"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background"      Value="Transparent"/>
                            <Setter Property="Padding"         Value="0,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#22C8A45A"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#11C8A45A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           Style="{StaticResource DS1Label}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SizeText}"
                                           Style="{StaticResource DS1Label}"
                                           FontFamily="{StaticResource DS1Mono}"
                                           FontSize="11"
                                           Opacity="0.45"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Style="{StaticResource DS1Button}"
                                        Content="REMOVE"
                                        Padding="10,4"
                                        Margin="12,0,0,0"
                                        Tag="{Binding FilePath}"
                                        Click="RemoveMod_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- ── Info panel ─────────────────────────────────────────────── -->
        <Border Style="{StaticResource DS1PanelBorder}">
            <StackPanel>
                <TextBlock Text="HOW IT WORKS"
                           Style="{StaticResource DS1SectionTitle}"
                           Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap"
                           Style="{StaticResource DS1Label}"
                           FontSize="12"
                           Opacity="0.75"
                           LineHeight="20">
Place mod DLLs in the mods/ folder inside your DSR game directory.&#10;&#10;When the game launches with the Mod Framework (dinput8.dll), each mod is loaded automatically and runs inside the game process.&#10;&#10;Mods implement OnLoad, OnTick, and OnUnload and can hook boss kills, fog gate entries, player deaths, and level-ups via the DS1Mod SDK.
                </TextBlock>

                <Separator Style="{StaticResource DS1Separator}" Margin="0,12"/>

                <Button Style="{StaticResource DS1Button}"
                        Content="OPEN MODS FOLDER"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Click="OpenModsFolder_Click"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
