<Window x:Class="DS1MegaRando.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:DS1MegaRando.UI.Pages"
        xmlns:controls="clr-namespace:DS1MegaRando.UI.Controls"
        mc:Ignorable="d"
        Title="DS1 Mega Randomizer"
        Height="720" Width="1100"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DS1Bg}"
        BorderBrush="{StaticResource DS1Gold}"
        BorderThickness="1">

    <Window.Resources>
        <!-- Page content DataTemplates -->
        <DataTemplate x:Key="GlobalPageTemplate">
            <pages:GlobalPage/>
        </DataTemplate>
        <DataTemplate x:Key="FogGatePageTemplate">
            <pages:FogGatePage/>
        </DataTemplate>
        <DataTemplate x:Key="ItemPageTemplate">
            <pages:ItemPage/>
        </DataTemplate>
        <DataTemplate x:Key="EnemyPageTemplate">
            <pages:EnemyPage/>
        </DataTemplate>
        <DataTemplate x:Key="SpoilerPageTemplate">
            <pages:SpoilerPage/>
        </DataTemplate>
        <DataTemplate x:Key="AboutPageTemplate">
            <pages:AboutPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Title bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="80"/>   <!-- Bottom bar -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource DS1StoneBg}"
                BorderBrush="{StaticResource DS1GoldDim}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- App name in sidebar header area -->
                <TextBlock Grid.Column="0"
                           Text="DS1 RANDO"
                           Style="{StaticResource DS1Heading}"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0"/>

                <!-- Title text -->
                <TextBlock Grid.Column="1"
                           Text="MEGA RANDOMIZER"
                           Style="{StaticResource DS1SectionTitle}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Opacity="0.7"/>
            </Grid>
        </Border>

        <!-- ── Main area ──────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>  <!-- Sidebar -->
                <ColumnDefinition Width="1"/>    <!-- Divider -->
                <ColumnDefinition Width="*"/>    <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource DS1StoneBg}"
                    x:Name="Sidebar">
                <StackPanel Margin="0,16,0,0">

                    <!-- DS1-style flame/soul icon (pure XAML) -->
                    <Canvas Width="40" Height="40"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <!-- Flame shape using bezier curves -->
                        <Path Fill="{StaticResource DS1Gold}" Opacity="0.8">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="20,38" IsClosed="True">
                                        <BezierSegment Point1="6,32" Point2="4,22" Point3="10,14"/>
                                        <BezierSegment Point1="12,10" Point2="14,6"  Point3="16,2"/>
                                        <BezierSegment Point1="17,8"  Point2="16,14" Point3="20,14"/>
                                        <BezierSegment Point1="22,10" Point2="24,8"  Point3="24,14"/>
                                        <BezierSegment Point1="30,20" Point2="34,28" Point3="30,36"/>
                                        <BezierSegment Point1="28,40" Point2="22,40" Point3="20,38"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <!-- Inner ember dot -->
                        <Ellipse Canvas.Left="16" Canvas.Top="22"
                                 Width="8" Height="10"
                                 Fill="#FF8040" Opacity="0.6"/>
                    </Canvas>

                    <!-- Navigation items -->
                    <RadioButton Style="{StaticResource DS1NavItem}"
                                 GroupName="Nav"
                                 IsChecked="True"
                                 x:Name="NavGlobal"
                                 Checked="NavItem_Checked"
                                 Tag="Global">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="GLOBAL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DS1NavItem}"
                                 GroupName="Nav"
                                 x:Name="NavFog"
                                 Checked="NavItem_Checked"
                                 Tag="FogGate">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="FOG GATES" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DS1NavItem}"
                                 GroupName="Nav"
                                 x:Name="NavItems"
                                 Checked="NavItem_Checked"
                                 Tag="Items">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="ITEMS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DS1NavItem}"
                                 GroupName="Nav"
                                 x:Name="NavEnemies"
                                 Checked="NavItem_Checked"
                                 Tag="Enemies">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☠ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="ENEMIES" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DS1NavItem}"
                                 GroupName="Nav"
                                 x:Name="NavSpoiler"
                                 Checked="NavItem_Checked"
                                 Tag="Spoiler">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="SPOILER LOG" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DS1NavItem}"
                                 GroupName="Nav"
                                 x:Name="NavDebug"
                                 Checked="NavItem_Checked"
                                 Tag="Debug">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="DEBUG INFO" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DS1NavItem}"
                                 GroupName="Nav"
                                 x:Name="NavAbout"
                                 Checked="NavItem_Checked"
                                 Tag="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="ABOUT" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Version info at bottom of sidebar -->
                    <TextBlock Text="v1.0.0"
                               Style="{StaticResource DS1Label}"
                               FontSize="10"
                               Opacity="0.4"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
            </Border>

            <!-- Vertical gold divider -->
            <Border Grid.Column="1"
                    Background="{StaticResource DS1GoldDim}"
                    Width="1"/>

            <!-- Content area -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource DS1Bg}">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DS1ScrollBar}"/>
                </ScrollViewer.Resources>
                <ContentControl x:Name="PageContent" Margin="24,20,24,20"/>
            </ScrollViewer>
        </Grid>

        <!-- ── Bottom bar ─────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource DS1StoneBg}"
                BorderBrush="{StaticResource DS1GoldDim}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status label -->
                <TextBlock Grid.Column="0"
                           x:Name="StatusLabel"
                           Text="Ready"
                           Style="{StaticResource DS1Label}"
                           FontSize="11"
                           Opacity="0.6"
                           VerticalAlignment="Center"/>

                <!-- Seed label -->
                <TextBlock Grid.Column="1"
                           Text="SEED:"
                           Style="{StaticResource DS1SectionTitle}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <!-- Seed input -->
                <TextBox Grid.Column="2"
                         x:Name="SeedInput"
                         Style="{StaticResource DS1TextBox}"
                         Width="100"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding Settings.Global.Seed, StringFormat={}{0:X8}, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Hex seed value. Edit to set a fixed seed."/>

                <!-- Roll seed button -->
                <Button Grid.Column="3"
                        Style="{StaticResource DS1Button}"
                        Content="ROLL"
                        Margin="8,0"
                        Click="RollSeed_Click"
                        ToolTip="Generate a new random seed"/>

                <!-- RANDOMIZE button (centered in remaining space) -->
                <Button Grid.Column="5"
                        Style="{StaticResource DS1ButtonPrimary}"
                        Content="  LINK THE FIRE  "
                        Click="Randomize_Click"
                        VerticalAlignment="Center"
                        Margin="0,0,0,0"/>

                <!-- Launch game split button -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource DS1Button}"
                            Content="▶ PLAY"
                            Click="LaunchGame_Click"
                            ToolTip="Launch Dark Souls Remastered"/>
                    <Button x:Name="LaunchDropdownBtn"
                            Style="{StaticResource DS1Button}"
                            Content="▾"
                            Padding="8,8"
                            Margin="2,0,0,0"
                            Click="LaunchDropdown_Click"
                            ToolTip="More launch options">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="▶  Standard Launch"
                                          Click="LaunchGame_Click"/>
                                <MenuItem Header="⚙  Launch with Mod Framework"
                                          Click="LaunchWithModFramework_Click"/>
                                <Separator/>
                                <MenuItem Header="✕  Remove Mod Framework"
                                          Click="RemoveModFramework_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Progress overlay ───────────────────────────────────── -->
        <controls:ProgressOverlay Grid.RowSpan="3"
                                   x:Name="ProgressOverlay"
                                   Visibility="Collapsed"/>
    </Grid>
</Window>
