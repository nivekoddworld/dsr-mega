<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Primary font: Optimus Princeps (medieval serif, close to DS1's title typeface)
        Download from: https://www.fontsquirrel.com/fonts/optimus-princeps
        Place .ttf files in Assets/Fonts/ folder.
        If font is not available, falls back to Georgia then serif.
    -->
    <FontFamily x:Key="DS1Font">
        pack://application:,,,/Assets/Fonts/#Optimus Princeps, Georgia, serif
    </FontFamily>

    <FontFamily x:Key="DS1FontBold">
        pack://application:,,,/Assets/Fonts/#Optimus Princeps SemiBold, Georgia, serif
    </FontFamily>

    <!-- Monospace font for spoiler log / seed display -->
    <FontFamily x:Key="DS1Mono">Consolas, Courier New, monospace</FontFamily>

    <!-- Font sizes -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DS1FontSizeTiny">10</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DS1FontSizeSmall">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DS1FontSizeNormal">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DS1FontSizeLarge">18</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DS1FontSizeTitle">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DS1FontSizeHuge">36</sys:Double>

</ResourceDictionary>
