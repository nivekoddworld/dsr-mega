<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DarkSoulsModLoader.Views.ModsPage"
             Background="#1a1a1a">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Installed Mods" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="#d4af37" />

        <!-- Mods List -->
        <ListBox Grid.Row="1" Background="#2a2a2a" BorderThickness="1" BorderBrush="#444444" CornerRadius="4" ItemsSource="{Binding Mods}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Foreground" Value="#cccccc" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="12,8" />
                </Style>
                <Style Selector="ListBoxItem:pointerover">
                    <Setter Property="Background" Value="#3a3a3a" />
                </Style>
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="#444444" />
                    <Setter Property="Foreground" Value="#d4af37" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="#d4af37" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DllPath}" Foreground="#888" FontSize="11" />
                        <CheckBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button Content="Refresh" Padding="12,8" Background="#d4af37" Foreground="#1a1a1a" FontWeight="Bold" CornerRadius="4" Click="OnRefreshClick" />
            <Button Content="Browse Folder" Padding="12,8" Background="#444444" Foreground="#d4af37" CornerRadius="4" />
        </StackPanel>
    </Grid>

</UserControl>
