<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DarkSoulsModLoader.Views.ConfigEditorPage"
             Background="#1a1410"
             Padding="12">
    <UserControl.Styles>
        <Style Selector="Button.gold">
            <Setter Property="Background" Value="#d4af37" />
            <Setter Property="Foreground" Value="#1a1410" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gold:pointerover">
            <Setter Property="Background" Value="#ffd700" />
        </Style>
        <Style Selector="Button.gold:pressed">
            <Setter Property="Background" Value="#c49722" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="auto,*,auto">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding ModName}" FontSize="20" Foreground="#ffd700" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#888888" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="✕"
                    Background="Transparent"
                    Foreground="#888888"
                    FontSize="18"
                    Padding="8,4"
                    Click="OnCloseClick"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Config Items List -->
        <ListBox Grid.Row="1" ItemsSource="{Binding ConfigItems}" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2a2a2a" Padding="12" Margin="0,4" CornerRadius="4" BorderThickness="1" BorderBrush="#444444">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15" />
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                            </Transitions>
                        </Border.Transitions>
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#323232" />
                                <Setter Property="BorderBrush" Value="#666666" />
                            </Style>
                        </Border.Styles>
                        <StackPanel Spacing="8">
                            <!-- Label with optional tooltip -->
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                                <TextBlock Grid.Column="0" Text="{Binding DisplayKey}" Foreground="#d4af37" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1"
                                           Text="?"
                                           Foreground="#d4af37"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="8,0,0,0"
                                           IsVisible="{Binding HasDescription}"
                                           ToolTip.ShowDelay="200">
                                    <ToolTip.Tip>
                                        <Border Background="#2a2a2a" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" MaxWidth="800">
                                            <ContentControl Content="{Binding FormattedDescription}" />
                                        </Border>
                                    </ToolTip.Tip>
                                </TextBlock>
                            </Grid>

                            <!-- Boolean Checkbox -->
                            <CheckBox IsChecked="{Binding BoolValue}"
                                      IsVisible="{Binding IsBool}" />

                            <!-- Enum ComboBox -->
                            <ComboBox ItemsSource="{Binding FormattedEnumValues}"
                                      SelectedIndex="{Binding SelectedEnumIndex}"
                                      IsVisible="{Binding IsEnum}"
                                      Background="#333333"
                                      Foreground="#cccccc"
                                      Padding="8" />

                            <!-- Text/String/Number TextBox -->
                            <TextBox Text="{Binding ValueString}"
                                     Background="#333333"
                                     Foreground="#cccccc"
                                     Padding="8"
                                     Watermark="Value"
                                     IsVisible="{Binding IsTextInput}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Save Button -->
        <Button Grid.Row="2"
                Classes="gold"
                Content="Save Config"
                Padding="12,8"
                HorizontalAlignment="Stretch"
                Margin="0,16,0,0"
                Click="OnSaveClick" />
    </Grid>
</UserControl>
