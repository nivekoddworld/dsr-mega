<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DarkSoulsModLoader.Views.LaunchPage"
             Background="#1a1410">

    <UserControl.Styles>
        <Style Selector="Button.gold">
            <Setter Property="Background" Value="#d4af37" />
            <Setter Property="Foreground" Value="#1a1410" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gold:pointerover">
            <Setter Property="Background" Value="#ffd700" />
        </Style>
        <Style Selector="Button.gold:pressed">
            <Setter Property="Background" Value="#c49722" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Launch Game" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="#ffd700" />

        <!-- Game Directory -->
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="Game Directory" FontWeight="Bold" Foreground="#cccccc" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding GameDirectory}" IsReadOnly="True" Background="#2a2a2a" Foreground="#cccccc" BorderBrush="#444444" />
                <Button Grid.Column="1" Classes="gold" Content="Browse..." Margin="8,0,0,0" Padding="12,8" Click="OnBrowseGameDirectory" />
            </Grid>
        </StackPanel>

        <!-- Mods Status -->
        <Border Grid.Row="2" Background="#2a2a2a" CornerRadius="4" Padding="12" Margin="0,16,0,0" BorderBrush="#444444" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="Status" FontWeight="Bold" Foreground="#d4af37" />
                <TextBlock Text="{Binding StatusText}" Foreground="#a89968" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding EnabledModCount}" Foreground="#a89968" />
                    <TextBlock Text="mods active" Foreground="#a89968" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Spacer -->
        <Border Grid.Row="3" />

        <!-- Launch Button -->
        <Button Grid.Row="4" Classes="gold" Content="Launch Dark Souls Remastered" Padding="16,12" FontSize="14" Click="OnLaunchClick" IsEnabled="{Binding CanLaunch}" />
    </Grid>

</UserControl>
