<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DarkSoulsModLoader.Views.DebugPage"
             Background="#0f0f0f">
    <UserControl.Styles>
        <Style Selector="Button.gold">
            <Setter Property="Background" Value="#d4af37" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gold:pointerover">
            <Setter Property="Background" Value="#e5c158" />
        </Style>
        <Style Selector="Button.gold:pressed">
            <Setter Property="Background" Value="#b8930f" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Debug Console" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="#d4af37" />

        <!-- Log Output -->
        <Border Grid.Row="1" Background="#000000" BorderBrush="#d4af37" BorderThickness="1" CornerRadius="0" Margin="0,0,0,12">
            <ListBox Background="#1a1a1a"
                     BorderThickness="0"
                     ItemsSource="{Binding LogLines}"
                     Focusable="False">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#a0a0a0"
                                   FontSize="11"
                                   FontFamily="Courier New"
                                   Margin="8,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Clear Button -->
        <Button Grid.Row="2" Classes="gold" Content="Clear Logs" Padding="12,8" Click="OnClearClick" />
    </Grid>
</UserControl>
