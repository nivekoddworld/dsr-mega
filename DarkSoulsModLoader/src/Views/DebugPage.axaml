<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DarkSoulsModLoader.Views.DebugPage"
             Background="#0f0f0f">
    <UserControl.Styles>
        <Style Selector="Button.gold">
            <Setter Property="Background" Value="#d4af37" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gold:pointerover">
            <Setter Property="Background" Value="#e5c158" />
        </Style>
        <Style Selector="Button.gold:pressed">
            <Setter Property="Background" Value="#b8930f" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="12">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Debug Console" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="#d4af37" />

        <!-- Controls -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Spacing="8" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Font Size:" Foreground="#cccccc" VerticalAlignment="Center" />
            <Slider Grid.Column="1"
                    Minimum="8"
                    Maximum="24"
                    Value="{Binding FontSize}"
                    Background="#1a1a1a"
                    Foreground="#d4af37"
                    VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="gold" Content="Copy Selected" Padding="12,6" Click="OnCopySelectedClick" />
            <Button Grid.Column="4" Classes="gold" Content="Copy All" Padding="12,6" Click="OnCopyAllClick" />
            <Button Grid.Column="5" Classes="gold" Content="Clear" Padding="12,6" Click="OnClearClick" />
        </Grid>

        <!-- Log Output -->
        <Border Grid.Row="2" Background="#000000" BorderBrush="#d4af37" BorderThickness="1" CornerRadius="0">
            <ListBox x:Name="LogListBox"
                     Background="#1a1a1a"
                     BorderThickness="0"
                     ItemsSource="{Binding LogLines}"
                     SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#a0a0a0"
                                   FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontFamily="Courier New"
                                   Margin="8,4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
