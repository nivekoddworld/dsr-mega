<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DarkSoulsModLoader.Views.MainWindow"
        Title="Dark Souls Mod Loader"
        Width="1000"
        Height="650"
        Background="#1a1a1a">

    <Grid RowDefinitions="*">
        <TextBlock x:Name="LoadingText" Text="Loading..." Foreground="#d4af37" Margin="16" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Grid>

</Window>
