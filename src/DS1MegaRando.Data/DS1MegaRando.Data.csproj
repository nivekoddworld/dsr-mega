<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed YAML annotation files as resources -->
    <EmbeddedResource Include="Annotations\ds1-fog.yaml" />
    <EmbeddedResource Include="Annotations\ds1-enemies.yaml" />
    <!-- Embed patched bonfire ESD (adds Level Up to all bonfires unconditionally) -->
    <EmbeddedResource Include="ESDs\bonfire_patched.esd" />
    <!-- Embed param layout XML files as resources -->
    <EmbeddedResource Include="Params\ITEMLOT_PARAM_ST.xml" />
    <EmbeddedResource Include="Params\NPC_PARAM_ST.xml" />
    <EmbeddedResource Include="Params\SHOP_LINEUP_PARAM.xml" />
    <EmbeddedResource Include="Params\CHARACTER_INIT_PARAM.xml" />
    <EmbeddedResource Include="Params\SP_EFFECT_PARAM_ST.xml" />
  </ItemGroup>

</Project>
